      "resource": [
        "qcs::cos:ap-guangzhou:uid/REPLACE_APPID:REPLACE_PRIVATE_BUCKET/lesson-one/profiles/*",
        "qcs::cos:ap-guangzhou:uid/REPLACE_APPID:REPLACE_PRIVATE_BUCKET/lesson-one/submissions/*",
        "qcs::cos:ap-guangzhou:uid/REPLACE_APPID:REPLACE_PRIVATE_BUCKET/lesson-one/tickets/*"
      ]
    }
  ]
}
